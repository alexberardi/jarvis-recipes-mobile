    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "30.0.0",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.10",
    "dotenv": "^16.4.7",
    "jest": "^30.5.1",
    "jest-expo": "~54.0.18",
    "react-native-worklets": "0.5.1",
    "typescript": "~5.9.2"
  },
  "private": true
