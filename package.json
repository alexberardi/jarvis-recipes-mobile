{
  "name": "jarvis-recipes-mobile",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "test:flows": "jest __tests__/flows",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "dev:ios": "open -a Simulator && npx expo run:ios --device \"iPhone 15\"",
    "dev-full:ios": "open -a Simulator && npx expo prebuild --clean && npx expo run:ios --device \"iPhone 15\""
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.8.11",
    "@react-navigation/native": "^7.1.24",
    "@react-navigation/native-stack": "^7.8.5",
    "@tanstack/react-query": "^5.90.12",
    "axios": "^1.13.2",
    "expo": "~54.0.37",
    "expo-crypto": "~15.0.9",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-paper": "^5.14.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-webview": "13.15.0"
