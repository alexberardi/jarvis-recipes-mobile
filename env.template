# =============================================================================
# jarvis-recipes-mobile - Environment Template
# =============================================================================
# Copy to .env and fill in values
# React Native mobile app
# =============================================================================

# -----------------------------------------------------------------------------
# API URLs (Local Development)
# -----------------------------------------------------------------------------
# Auth service URL (jarvis-auth)
EXPO_PUBLIC_AUTH_API_BASE_URL=http://localhost:7701

# Recipes service URL (jarvis-recipes-server)
EXPO_PUBLIC_RECIPES_API_BASE_URL=http://localhost:7030

# -----------------------------------------------------------------------------
# NOTES
# -----------------------------------------------------------------------------
# For EAS builds (staging/production), these are defined in eas.json
#
# When testing on physical device, replace localhost with your machine's IP:
# EXPO_PUBLIC_AUTH_API_BASE_URL=http://192.168.1.XXX:7701
# EXPO_PUBLIC_RECIPES_API_BASE_URL=http://192.168.1.XXX:7030
